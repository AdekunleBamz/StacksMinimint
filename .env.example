# Note: .Env config
# Scope: minimal clarity note.

# Environment Variables
# Copy this file to .env and fill in your values

# Private key for Stacks deployment
# WARNING: Never commit your actual private key!
PRIVATE_KEY=your_private_key_here

# Stacks API URL (optional)
# STACKS_API_URL=https://api.hiro.so

# Contract Addresses (set after deployment)
MINIMINT_CORE_ADDRESS=
MINIMINT_TOKEN_ADDRESS=
MINIMINT_HUB_ADDRESS=

# Frontend network target
# Options: mainnet, testnet
NETWORK=mainnet

# Deployment configuration
# DEPLOYMENT_ENV=production
