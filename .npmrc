# .npmrc - NPM configuration for consistent behavior across environments
# See: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

# Use exact versions when saving dependencies
save-exact=true

# Use ci instead of install for reproducible builds
prefer-offline=true

# Audit packages for vulnerabilities
audit=true

# Engine strict mode - fail if Node version doesn't match
engine-strict=true

# Use fund to show funding info for packages
fund=true

# Disable npm update check notifications
update-notifier=false